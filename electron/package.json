{
  "name": "bitchord-electron",
  "productName": "BitChord",
  "version": "1.0.0",
  "description": "BitChord Music Player Desktop Client",
  "main": "main.js",
  "author": "BitChord Contributors",
  "build": {
    "appId": "com.bitchord.desktop",
    "productName": "BitChord",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "icon.ico",
      "app/**/*",
      "extension/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  }
}
